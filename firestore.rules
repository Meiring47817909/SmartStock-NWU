rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }

    function hasBicsRole(roles) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/profiles/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role in roles;
    }

    function isOwnStaffRecord(staffId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/staff/$(staffId)) &&
        get(/databases/$(database)/documents/staff/$(staffId)).data.uid == request.auth.uid;
    }

    function isOwnRequestOwner(requestId) {
      return exists(/databases/$(database)/documents/loan_requests/$(requestId)) &&
        isOwnStaffRecord(get(/databases/$(database)/documents/loan_requests/$(requestId)).data.staff_id);
    }

    function affectedKeysOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // ---- Existing BICS collections ----

    match /profiles/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false; // written only via Admin SDK
    }

    match /products/{productId} {
      allow read: if isSignedIn(); // BICS operators AND portal borrowers (Browse page)
      allow create, delete: if hasBicsRole(['admin', 'manager']);
      allow update: if hasBicsRole(['admin', 'manager']) ||
        (hasBicsRole(['staff']) && affectedKeysOnly(['quantity_on_hand', 'updated_at']));
    }

    match /categories/{categoryId} {
      allow read: if hasBicsRole(['admin', 'manager', 'staff']);
      allow write: if hasBicsRole(['admin', 'manager']);
    }

    match /staff/{staffId} {
      allow read: if hasBicsRole(['admin', 'manager', 'staff']) ||
        (isSignedIn() && resource.data.uid == request.auth.uid);
      allow write: if hasBicsRole(['admin']); // uid-linking itself is via Admin SDK
    }

    match /transactions/{txnId} {
      allow read: if hasBicsRole(['admin', 'manager', 'staff']);
      allow create: if hasBicsRole(['admin', 'manager', 'staff']);
      allow update, delete: if false; // append-only, confirmed no updateDoc/deleteDoc anywhere
    }

    match /transaction_lines/{lineId} {
      allow read, create: if hasBicsRole(['admin', 'manager', 'staff']);
      allow update, delete: if false;
    }

    match /audit_log/{entryId} {
      allow read: if hasBicsRole(['admin']);
      // Portal borrowers also need to write audit_log entries: My Requests
      // (lend/requests/page.tsx) lazily calls expireIfNeeded on load just
      // like Selouna's queue does, and that transition is logged the same
      // way regardless of who triggered it. Scoped to loan_request entries
      // only — a borrower has no legitimate reason to log anything else.
      allow create: if hasBicsRole(['admin', 'manager', 'staff']) ||
        (isSignedIn() && request.resource.data.entity_type == 'loan_request');
      allow update, delete: if false;
    }

    // ---- New portal collections ----

    match /loan_requests/{requestId} {
      // Read is open to any signed-in user (BICS or portal borrower), not
      // scoped to "own requests" — the reservation ledger (getReservedQuantity
      // in loanRequests.ts) has to scan ALL active requests for a product
      // across every borrower to compute live availability, and per
      // LENDING_PORTAL_SPEC.md decision #7 that check runs client-side in
      // the portal itself (Cart page, before submission) as well as in
      // Selouna's queue. A stricter "only your own requests" read rule (a
      // literal reading of §2.3) would silently break that client-side
      // conflict check for every borrower — same posture as `products`
      // above, which is also read-open for the same reason.
      allow read: if isSignedIn();
      allow create: if isOwnStaffRecord(request.resource.data.staff_id);

      // Selouna: full transition rights (approve/counter/decline/fulfil/expire/no-show)
      allow update: if hasBicsRole(['admin', 'manager']);

      // BICS staff-role (till operators): narrow — only the fulfilment write Stock Out
      // needs, plus lazy expire/no-show writes any list page may trigger on load. §2.3
      // of LENDING_PORTAL_SPEC.md says staff-role gets read-only, but canManageStock
      // (which gates Stock Out) is true for every role, so a literal read-only rule
      // would break the fulfillment write for non-admin/manager till operators.
      allow update: if hasBicsRole(['staff']) &&
        ((affectedKeysOnly(['status', 'updated_at', 'fulfilled_txn_id']) &&
          resource.data.status == 'accepted' && request.resource.data.status == 'fulfilled') ||
         (affectedKeysOnly(['status', 'updated_at']) &&
          ((resource.data.status in ['pending', 'countered'] && request.resource.data.status == 'expired') ||
           (resource.data.status == 'accepted' && request.resource.data.status == 'no_show'))));

      // Portal borrower: only their own request, only status/updated_at, only these
      // specific state-machine edges (dates/staff_id/message are immutable from their side).
      allow update: if isOwnStaffRecord(resource.data.staff_id) && affectedKeysOnly(['status', 'updated_at']) &&
        ((resource.data.status == 'countered' && request.resource.data.status in ['accepted', 'declined']) ||
         (resource.data.status in ['pending', 'countered', 'accepted'] && request.resource.data.status == 'withdrawn') ||
         (resource.data.status in ['pending', 'countered'] && request.resource.data.status == 'expired') ||
         (resource.data.status == 'accepted' && request.resource.data.status == 'no_show'));

      allow delete: if false;
    }

    match /loan_request_lines/{lineId} {
      // Same reasoning as loan_requests read above — getReservedQuantity
      // needs to sum offered_quantity across every active request's lines
      // for a given product_id, not just the caller's own.
      allow read: if isSignedIn();
      allow create: if hasBicsRole(['admin', 'manager']) || isOwnRequestOwner(request.resource.data.request_id);
      allow update: if hasBicsRole(['admin', 'manager']); // offered_quantity edits — Selouna only
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
