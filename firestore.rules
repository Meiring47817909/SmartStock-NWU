rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }

    // BICS access is admin-only. The 'staff' role is lending-portal only and
    // is deliberately NOT a BICS role — a portal borrower normally has no
    // profiles doc at all, and one carrying role 'staff' is treated the same
    // way. Kept as a roles-list helper rather than a bare isAdmin() so that
    // re-introducing a middle role later is a change to the call sites, not
    // to the shape of every rule.
    function hasBicsRole(roles) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/profiles/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role in roles;
    }

    function isOwnStaffRecord(staffId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/staff/$(staffId)) &&
        get(/databases/$(database)/documents/staff/$(staffId)).data.uid == request.auth.uid;
    }

    function isOwnRequestOwner(requestId) {
      return exists(/databases/$(database)/documents/loan_requests/$(requestId)) &&
        isOwnStaffRecord(get(/databases/$(database)/documents/loan_requests/$(requestId)).data.staff_id);
    }

    function affectedKeysOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // ---- Existing BICS collections ----

    match /profiles/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false; // written only via Admin SDK
    }

    match /products/{productId} {
      // Public read, no auth required — the lending portal's Browse page
      // (lend/page.tsx) is open to guests who haven't signed in yet, not
      // just BICS operators and portal borrowers. Every write stays gated.
      allow read: if true;
      allow create, delete: if hasBicsRole(['admin']);
      // The previous narrow staff-role clause (quantity_on_hand + updated_at
      // only, for Stock Out's decrement) is gone: Stock Out is admin-only
      // now, and admin already has full update rights here.
      allow update: if hasBicsRole(['admin']);
    }

    match /categories/{categoryId} {
      allow read, write: if hasBicsRole(['admin']);
    }

    match /staff/{staffId} {
      allow read: if hasBicsRole(['admin']) ||
        (isSignedIn() && resource.data.uid == request.auth.uid);
      allow write: if hasBicsRole(['admin']); // uid-linking itself is via Admin SDK
    }

    match /transactions/{txnId} {
      allow read, create: if hasBicsRole(['admin']);
      allow update, delete: if false; // append-only, confirmed no updateDoc/deleteDoc anywhere
    }

    match /transaction_lines/{lineId} {
      allow read, create: if hasBicsRole(['admin']);
      allow update, delete: if false;
    }

    // Return waivers — Selouna writing off an outstanding loan line because
    // she's agreed the staff member keeps the item. Append-only for the same
    // reason transactions/transaction_lines are: the outstanding calculation
    // is a replay over this ledger, and a mutable or deletable waiver would
    // make a past Dashboard state unreproducible. Admin-only in both
    // directions: every page that subtracts waivers (Dashboard, Returns,
    // Staff, Reports) is itself admin-only now.
    match /return_waivers/{waiverId} {
      allow read: if hasBicsRole(['admin']);
      allow create: if hasBicsRole(['admin']);
      allow update, delete: if false;
    }

    match /audit_log/{entryId} {
      allow read: if hasBicsRole(['admin']);
      // Portal borrowers also need to write audit_log entries: My Requests
      // (lend/requests/page.tsx) lazily calls expireIfNeeded on load just
      // like Selouna's queue does, and that transition is logged the same
      // way regardless of who triggered it. Scoped to loan_request entries
      // only — a borrower has no legitimate reason to log anything else.
      allow create: if hasBicsRole(['admin']) ||
        (isSignedIn() && request.resource.data.entity_type == 'loan_request');
      allow update, delete: if false;
    }

    // ---- New portal collections ----

    match /loan_requests/{requestId} {
      // Read is open to any signed-in user (BICS or portal borrower), not
      // scoped to "own requests" — the reservation ledger (getReservedQuantity
      // in loanRequests.ts) has to scan ALL active requests for a product
      // across every borrower to compute live availability, and per
      // LENDING_PORTAL_SPEC.md decision #7 that check runs client-side in
      // the portal itself (Cart page, before submission) as well as in
      // Selouna's queue. A stricter "only your own requests" read rule (a
      // literal reading of §2.3) would silently break that client-side
      // conflict check for every borrower — same posture as `products`
      // above, which is also read-open for the same reason.
      allow read: if isSignedIn();
      allow create: if isOwnStaffRecord(request.resource.data.staff_id);

      // Selouna: full transition rights (approve/counter/decline/fulfil/expire/no-show).
      // The separate narrow clause that used to exist for BICS staff-role till
      // operators (the accepted -> fulfilled write from Stock Out, plus lazy
      // expire/no-show) is gone with the role itself — Stock Out is admin-only
      // now, so this one clause covers every BICS-side transition.
      allow update: if hasBicsRole(['admin']);

      // Portal borrower: only their own request, only status/updated_at, only these
      // specific state-machine edges (dates/staff_id/message are immutable from their side).
      allow update: if isOwnStaffRecord(resource.data.staff_id) && affectedKeysOnly(['status', 'updated_at']) &&
        ((resource.data.status == 'countered' && request.resource.data.status in ['accepted', 'declined']) ||
         (resource.data.status in ['pending', 'countered', 'accepted'] && request.resource.data.status == 'withdrawn') ||
         (resource.data.status in ['pending', 'countered'] && request.resource.data.status == 'expired') ||
         (resource.data.status == 'accepted' && request.resource.data.status == 'no_show'));

      allow delete: if false;
    }

    match /loan_request_lines/{lineId} {
      // Same reasoning as loan_requests read above — getReservedQuantity
      // needs to sum offered_quantity across every active request's lines
      // for a given product_id, not just the caller's own.
      allow read: if isSignedIn();
      allow create: if hasBicsRole(['admin']) || isOwnRequestOwner(request.resource.data.request_id);
      allow update: if hasBicsRole(['admin']); // offered_quantity edits — Selouna only
      allow delete: if false;
    }

    // ---- App configuration ----

    // Admin-only app settings -- currently just the notification-email
    // on/off toggles (see NotificationSettings / settings/notifications in
    // (protected)/settings/notifications). Same admin-only read+write
    // posture as categories: nobody but an admin needs to read or change
    // these, and there's no portal-facing use for them.
    match /settings/{settingId} {
      allow read, write: if hasBicsRole(['admin']);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
