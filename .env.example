# SmartStock-NWU environment settings.
#
# Copy this file to .env.local:   copy .env.example .env.local   (PowerShell / cmd)
#                                 cp .env.example .env.local     (Git Bash, macOS, Linux)
# Never commit .env.local: it is ignored by git because it can hold secrets.
#
# For local development (npm run dev:emulators against the Firebase emulators) the values below work as
# they are; nothing has to be filled in. dev:emulators sets the emulator, mail and database settings itself.

# --- Firebase web settings -------------------------------------------------------------------------------
# Locally these only need to be non-empty: the emulators do not check them, and the app uses the project id
# demo-smartstock-nwu while NEXT_PUBLIC_USE_FIREBASE_EMULATORS is true. Keep the bucket name as it is: the
# seed scripts store the product photos in that bucket and the app reads them from it.
# For the live site, use the values from the Firebase console (Project settings, General, Your apps).
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-smartstock-nwu.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-smartstock-nwu
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=smartstock-nwu.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000

# --- Only for the real Firebase project (npm run dev, or seed:demo --target live) ------------------------
# The Admin SDK service account (Firebase console, Project settings, Service accounts). Secret: never share.
# Not needed with the emulators.
# FIREBASE_ADMIN_PROJECT_ID=
# FIREBASE_ADMIN_CLIENT_EMAIL=
# FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Database ----------------------------------------------------------------------------------------------
# Read by Next.js only (npm run dev / build / start). The db:* scripts and the seeds read DATABASE_URL from
# the shell instead, and use this local database when it is not set.
# DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/smartstock

# --- Optional ------------------------------------------------------------------------------------------------
# Base of the links in emails (default http://localhost:3000):
# APP_BASE_URL=http://localhost:3000
# Only for rebuilding the catalogue photos (npm run images:fetch / npm run images:generate):
# PIXABAY_API_KEY=
# GEMINI_API_KEY=
