rules_version = '2';

// Product photos are publicly readable. Nobody writes or deletes them from a
// browser: the app's server stores and removes them with the Admin SDK (which
// these rules don't apply to) after checking the caller is an admin in Cloud
// SQL -- see src/server/productImages.ts and /api/products/images. Firestore
// is no longer consulted. Deploy after changing:
//   npx firebase-tools deploy --only storage --project <project-id>
service firebase.storage {
  match /b/{bucket}/o {
    match /products/{productId}/{fileName} {
      allow read: if true;
      allow write, delete: if false;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
