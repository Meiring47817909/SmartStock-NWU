rules_version = '2';

// Cut-over write freeze for the OLD (Firestore) app. Deployed before the last dry run so nothing can change in Firestore
// between that dry run and the import (handout.md, "Cut-over to Cloud SQL", step 4):
//   npx firebase-tools deploy --only firestore:rules --config scripts/cutover/firebase.freeze.json --project <project-id>
//
// - Every client write is refused (allow write: if false), for every collection and every user, admins included.
// - Reads are exactly what the old firestore.rules allowed (git show bf8ecec:firestore.rules), so the old app still
//   shows its data read-only and products stay readable without signing in.
// - The importer reads through the Firebase Admin SDK, which security rules never apply to, so it is unaffected.
// To abandon the cut-over, redeploy the old app's own firestore.rules from the old branch (see the handout).
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }

    function hasBicsRole(roles) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/profiles/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role in roles;
    }

    match /profiles/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
    }

    match /products/{productId} {
      // Public read, as before: the lending portal's Browse page is open to guests.
      allow read: if true;
    }

    match /categories/{categoryId} {
      allow read: if hasBicsRole(['admin']);
    }

    match /staff/{staffId} {
      allow read: if hasBicsRole(['admin']) ||
        (isSignedIn() && resource.data.uid == request.auth.uid);
    }

    match /transactions/{txnId} {
      allow read: if hasBicsRole(['admin']);
    }

    match /transaction_lines/{lineId} {
      allow read: if hasBicsRole(['admin']);
    }

    match /return_waivers/{waiverId} {
      allow read: if hasBicsRole(['admin']);
    }

    match /audit_log/{entryId} {
      allow read: if hasBicsRole(['admin']);
    }

    match /loan_requests/{requestId} {
      allow read: if isSignedIn();
    }

    match /loan_request_lines/{lineId} {
      allow read: if isSignedIn();
    }

    match /settings/{settingId} {
      allow read: if hasBicsRole(['admin']);
    }

    // The freeze itself: no client may create, update or delete any document. Rules are OR-ed, so this one statement
    // covers every collection above (none of them allows a write) and everything else.
    match /{document=**} {
      allow write: if false;
    }
  }
}
